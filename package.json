{
  "name": "judg3d-monorepo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build --force && tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "tsc --build && vitest run",
    "judg3d": "node packages/cli/dist/index.js",
    "fixtures:fetch": "node fixtures/scripts/fetch-khronos.mjs",
    "fixtures:broken": "node fixtures/scripts/make-quebrado.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.2.0",
    "eslint": "10.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  }
}
