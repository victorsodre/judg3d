{
  "name": "@judg3d/app",
  "version": "0.2.0",
  "type": "module",
  "description": "Local judg3d app: UI and API powered by @judg3d/judge.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "node ../../tools/build-assets.mjs && tsc --build && vite build",
    "build:server": "node ../../tools/build-assets.mjs && tsc --build",
    "build:ui": "vite build",
    "dev": "concurrently -k -n server,ui -c teal,magenta \"pnpm run dev:server\" \"pnpm run dev:ui\"",
    "dev:server": "pnpm run build:server && JUDG3D_APP_SERVE_CLIENT=0 node --watch dist/index.js",
    "dev:ui": "vite",
    "start": "node dist/index.js",
    "typecheck": "tsc --build --force && tsc -p tsconfig.ui.json --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "1.19.17",
    "@judg3d/core": "workspace:*",
    "@judg3d/judge": "workspace:*",
    "hono": "4.13.7"
  },
  "devDependencies": {
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.2",
    "concurrently": "10.0.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "vite": "7.3.6"
  },
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/start.d.ts",
      "import": "./dist/start.js"
    }
  },
  "files": [
    "dist",
    "client-dist",
    "bundled-profiles",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/victorsodre/judg3d.git",
    "directory": "packages/app"
  },
  "homepage": "https://github.com/victorsodre/judg3d#readme",
  "bugs": {
    "url": "https://github.com/victorsodre/judg3d/issues"
  },
  "keywords": [
    "gltf",
    "glb",
    "3d",
    "validation",
    "asset-pipeline",
    "mcp"
  ]
}
